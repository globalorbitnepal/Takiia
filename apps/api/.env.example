# Server
# Production: HOST=127.0.0.1 PORT=3033 (Nginx terminates TLS and proxies to this address)
HOST=0.0.0.0
PORT=4000
NODE_ENV=development

# PostgreSQL (local development only — never commit real credentials)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/takiia_dev?schema=public"

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Auth (use a long random value in production)
SESSION_SECRET=dev-only-change-me-in-production-32chars!!
COOKIE_DOMAIN=
PUBLIC_WEB_URL=http://localhost:3000

# Uploads (local path on API server)
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# Optional SMTP for verification/reset emails
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@takiia.com

# WebRTC (configure TURN for production calling)
STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=
