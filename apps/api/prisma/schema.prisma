generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageDeliveryState {
  SENT
  DELIVERED
  READ
}

enum CallType {
  VOICE
  VIDEO
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  MISSED
  DECLINED
}

enum ReportStatus {
  OPEN
  REVIEWED
  DISMISSED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TIKTOK
}

enum SocialAccountStatus {
  PENDING
  CONNECTED
  EXPIRED
  REVOKED
}

enum ScheduledPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELED
}

enum PublishJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  emailNormalized String    @unique
  passwordHash    String
  displayName     String
  bio             String?
  avatarUrl       String?
  role            UserRole  @default(USER)
  emailVerifiedAt DateTime?
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions                 Session[]
  refreshTokens            RefreshToken[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  memberships              ConversationMember[]
  sentMessages             Message[]                @relation("MessageSender")
  deliveryReceipts         MessageDeliveryReceipt[]
  readReceipts             MessageReadReceipt[]
  conversationReadStates   ConversationReadState[]
  attachments              Attachment[]
  blocksInitiated          UserBlock[]              @relation("Blocker")
  blocksReceived           UserBlock[]              @relation("Blocked")
  reportsFiled             UserReport[]             @relation("Reporter")
  reportsReceived          UserReport[]             @relation("Reported")
  devices                  Device[]
  notificationPreference   NotificationPreference?
  callParticipants         CallParticipant[]
  auditEvents              AuditEvent[]
  directPairsAsUserA       DirectConversationPair[] @relation("DirectUserA")
  directPairsAsUserB       DirectConversationPair[] @relation("DirectUserB")
  groupInvitationsSent     GroupInvitation[]        @relation("Inviter")
  groupInvitationsReceived GroupInvitation[]        @relation("Invitee")
  ownedWorkspaces          Workspace[]              @relation("WorkspaceOwner")
  workspaceMemberships     WorkspaceMember[]
  scheduledPostsAuthored   ScheduledPost[]
  workspaceEvents          WorkspaceEvent[]

  @@index([displayName])
  @@index([lastSeenAt])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  replacedById String?   @unique @db.Uuid

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshRotation", fields: [replacedById], references: [id])
  replaces   RefreshToken? @relation("RefreshRotation")

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Conversation {
  id            String           @id @default(uuid()) @db.Uuid
  type          ConversationType
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  lastMessageAt DateTime?

  members      ConversationMember[]
  messages     Message[]
  groupProfile GroupProfile?
  directPair   DirectConversationPair?
  invitations  GroupInvitation[]
  calls        Call[]
  readStates   ConversationReadState[]

  @@index([lastMessageAt])
  @@index([type])
}

model DirectConversationPair {
  id             String @id @default(uuid()) @db.Uuid
  conversationId String @unique @db.Uuid
  userAId        String @db.Uuid
  userBId        String @db.Uuid

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userA        User         @relation("DirectUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB        User         @relation("DirectUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId, userAId])
}

model ConversationMember {
  id             String     @id @default(uuid()) @db.Uuid
  conversationId String     @db.Uuid
  userId         String     @db.Uuid
  role           MemberRole @default(MEMBER)
  joinedAt       DateTime   @default(now())
  leftAt         DateTime?
  mutedUntil     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model GroupProfile {
  conversationId String  @id @db.Uuid
  name           String
  description    String?
  avatarUrl      String?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model GroupInvitation {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  inviterId      String    @db.Uuid
  inviteeId      String    @db.Uuid
  createdAt      DateTime  @default(now())
  acceptedAt     DateTime?
  declinedAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee      User         @relation("Invitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@unique([conversationId, inviteeId])
}

model Message {
  id              String    @id @default(uuid()) @db.Uuid
  conversationId  String    @db.Uuid
  senderId        String    @db.Uuid
  body            String?
  clientMessageId String?
  replyToId       String?   @db.Uuid
  createdAt       DateTime  @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?

  conversation Conversation             @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?                 @relation("MessageReplies", fields: [replyToId], references: [id])
  replies      Message[]                @relation("MessageReplies")
  attachments  Attachment[]
  deliveries   MessageDeliveryReceipt[]
  reads        MessageReadReceipt[]

  @@unique([conversationId, senderId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([senderId])
}

model MessageDeliveryReceipt {
  id          String   @id @default(uuid()) @db.Uuid
  messageId   String   @db.Uuid
  userId      String   @db.Uuid
  deliveredAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model MessageReadReceipt {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model ConversationReadState {
  id                String   @id @default(uuid()) @db.Uuid
  conversationId    String   @db.Uuid
  userId            String   @db.Uuid
  lastReadMessageId String?  @db.Uuid
  unreadCount       Int      @default(0)
  updatedAt         DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
}

model Attachment {
  id         String   @id @default(uuid()) @db.Uuid
  messageId  String?  @db.Uuid
  uploaderId String   @db.Uuid
  filename   String
  mimeType   String
  sizeBytes  Int
  storageKey String   @unique
  createdAt  DateTime @default(now())

  message  Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploader User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([uploaderId])
}

model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model UserReport {
  id         String       @id @default(uuid()) @db.Uuid
  reporterId String       @db.Uuid
  reportedId String       @db.Uuid
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reportedId])
}

model Device {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  platform  String
  pushToken String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreference {
  userId         String  @id @db.Uuid
  emailEnabled   Boolean @default(true)
  pushEnabled    Boolean @default(true)
  messagePreview Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Call {
  id             String     @id @default(uuid()) @db.Uuid
  conversationId String?    @db.Uuid
  type           CallType
  status         CallStatus @default(RINGING)
  startedAt      DateTime   @default(now())
  endedAt        DateTime?

  conversation Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  participants CallParticipant[]

  @@index([conversationId])
}

model CallParticipant {
  id       String    @id @default(uuid()) @db.Uuid
  callId   String    @db.Uuid
  userId   String    @db.Uuid
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callId, userId])
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action])
}

model Plan {
  id                        String   @id @default(uuid()) @db.Uuid
  code                      String   @unique
  name                      String
  monthlyPriceCents         Int
  yearlyPriceCents          Int
  maxMembers                Int
  maxSocialAccounts         Int
  maxScheduledPostsPerMonth Int
  maxStorageBytes           BigInt
  maxMeetingMinutesPerMonth Int
  maxMeetingParticipants    Int      @default(10)
  features                  Json?
  active                    Boolean  @default(true)
  sortOrder                 Int      @default(0)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  subscriptions WorkspaceSubscription[]
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  ownerId   String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner          User                   @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members        WorkspaceMember[]
  subscription   WorkspaceSubscription?
  usageRecords   UsageRecord[]
  socialAccounts SocialAccount[]
  scheduledPosts ScheduledPost[]
  events         WorkspaceEvent[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String     @db.Uuid
  userId      String     @db.Uuid
  role        MemberRole @default(MEMBER)
  joinedAt    DateTime   @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceSubscription {
  id                     String             @id @default(uuid()) @db.Uuid
  workspaceId            String             @unique @db.Uuid
  planId                 String             @db.Uuid
  status                 SubscriptionStatus @default(TRIALING)
  billingInterval        BillingInterval    @default(MONTHLY)
  currentPeriodStart     DateTime
  currentPeriodEnd       DateTime
  cancelAtPeriodEnd      Boolean            @default(false)
  paymentProvider        String?
  externalSubscriptionId String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id])

  @@index([planId])
  @@index([status])
}

model UsageRecord {
  id                  String   @id @default(uuid()) @db.Uuid
  workspaceId         String   @db.Uuid
  periodStart         DateTime
  periodEnd           DateTime
  scheduledPostsCount Int      @default(0)
  storageBytesUsed    BigInt   @default(0)
  meetingMinutesUsed  Int      @default(0)
  updatedAt           DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, periodStart])
  @@index([workspaceId, periodEnd])
}

model SocialAccount {
  id                String              @id @default(uuid()) @db.Uuid
  workspaceId       String              @db.Uuid
  platform          SocialPlatform
  status            SocialAccountStatus @default(PENDING)
  displayName       String?
  externalAccountId String?
  tokenCiphertext   String?
  tokenExpiresAt    DateTime?
  scopes            String?
  connectedAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  postTargets PostTarget[]
  publishJobs PublishJob[]

  @@unique([workspaceId, platform, externalAccountId])
  @@index([workspaceId])
}

model ScheduledPost {
  id              String              @id @default(uuid()) @db.Uuid
  workspaceId     String              @db.Uuid
  authorId        String              @db.Uuid
  body            String
  mediaStorageKey String?
  scheduledFor    DateTime?
  status          ScheduledPostStatus @default(DRAFT)
  idempotencyKey  String?             @unique
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  targets   PostTarget[]
  jobs      PublishJob[]

  @@index([workspaceId, scheduledFor])
  @@index([authorId])
}

model PostTarget {
  id              String @id @default(uuid()) @db.Uuid
  scheduledPostId String @db.Uuid
  socialAccountId String @db.Uuid

  scheduledPost ScheduledPost @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([scheduledPostId, socialAccountId])
}

model PublishJob {
  id              String           @id @default(uuid()) @db.Uuid
  scheduledPostId String           @db.Uuid
  socialAccountId String           @db.Uuid
  status          PublishJobStatus @default(PENDING)
  attempts        Int              @default(0)
  lastError       String?
  externalPostId  String?
  idempotencyKey  String           @unique
  nextAttemptAt   DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  scheduledPost ScheduledPost @relation(fields: [scheduledPostId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
}

model WorkspaceEvent {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  creatorId   String   @db.Uuid
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  timezone    String   @default("UTC")
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator   User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([workspaceId, startsAt])
}
