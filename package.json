{
  "name": "takiia",
  "version": "0.1.0",
  "private": true,
  "description": "Takiia — messaging and voice/video calling platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace @takiia/api",
    "dev:web": "npm run dev --workspace @takiia/web",
    "dev:mobile": "npm run start --workspace @takiia/mobile",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @takiia/api --if-present",
    "postinstall": "npm run build --workspace @takiia/shared --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "engines": {
    "node": ">=20"
  }
}
