# Dependencies
node_modules/

# Build outputs
dist/
packages/shared/dist/
build/
.next/
out/
.expo/
web-build/
*.tsbuildinfo

# Environment (never commit secrets)
.env
.env.*
!.env.example
!.env.*.example

# Logs
logs/
*.log
npm-debug.log*

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Testing / coverage
coverage/

# Secrets and backups
*.pem
*.key
*.p12
*.jks
*.mobileprovision
*.sql
!apps/api/prisma/migrations/**/*.sql
*.dump
*.bak

# Mobile native build artifacts
apps/mobile/.gradle/
apps/mobile/android/app/build/
apps/mobile/ios/build/

# Server-only deploy marker (written on successful deploy)
.deploy-last-known-good
.deploy-metadata.json
scripts/deploy/.ci-verify-deploy-*/

# Production PM2 config (copy from infra/pm2/ecosystem.config.example.cjs on the server)
ecosystem.config.cjs

# Accidental empty file sometimes created by shell redirects
/path

# Misc
.turbo/
.cache/
actionlint
actionlint.exe
